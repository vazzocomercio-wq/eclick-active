# ════════════════════════════════════════════════════════════
# e-Click Active — Workers (.env.example)
# ════════════════════════════════════════════════════════════
# Workers mantém sessões persistentes do Baileys (WhatsApp Free) e
# expõe internal-server pro api consultar via INTERNAL_API_KEY.
# ════════════════════════════════════════════════════════════

# ── Internal server ──
# Porta do internal-server. Default 3030.
WORKER_INTERNAL_PORT=3030

# Bind do internal-server.
#   - Dev local: 127.0.0.1 (loopback only — segurança)
#   - Railway/k8s/Docker Compose: 0.0.0.0 (cross-container)
# O Dockerfile já seta 0.0.0.0 por default em runtime — só override aqui
# se precisar.
WORKER_INTERNAL_BIND=127.0.0.1

# URL do API service pra workers fazer broadcastRealtime (POST
# /internal/realtime).
#   - Dev: http://127.0.0.1:3001
#   - Railway: http://api.railway.internal:3001 (private DNS)
INTERNAL_API_URL=http://127.0.0.1:3001

# Secret compartilhado com o api — DEVE ser idêntico em ambos os .env
INTERNAL_API_KEY=

# ── Supabase ──
# Workers acessa direto o Supabase (não passa pelo api) pra:
#  - persistir mensagens inbound recebidas via Baileys
#  - ler/escrever channels (status do pareamento)
SUPABASE_URL=https://hzhrkfdwzxalaromcffn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Baileys tuning ──
# Polling interval pra checar canais novos/desconectados (segundos).
# Default 3.
BAILEYS_POLL_INTERVAL_SEC=3

# Log level do Baileys (silent | trace | debug | info | warn | error | fatal).
# Em prod, recomendado 'warn' pra não floodar logs do container.
BAILEYS_LOG_LEVEL=warn
