# ════════════════════════════════════════════════════════════
# e-Click Active — API (.env.example)
# ════════════════════════════════════════════════════════════
# Copie pra apps/api/.env e preencha. NUNCA commitar .env real.
# ════════════════════════════════════════════════════════════

# ── Server ──
# Porta HTTP. Default 3001. Em Railway é setada automaticamente — deixa
# como está e o adapter do Nest lê do env.
PORT=3001

# ── CORS ──
# Origens permitidas pra REST + Socket.IO, separadas por vírgula.
# Deixa vazio em prod e usa os defaults (active.eclick.app.br + localhost).
# Em dev, pode setar WEB_ORIGIN pra adicionar uma origem custom.
# CORS_ORIGINS=https://active.eclick.app.br,https://www.active.eclick.app.br
WEB_ORIGIN=http://localhost:3000

# ── Supabase ──
# Project URL (https://<ref>.supabase.co)
SUPABASE_URL=https://hzhrkfdwzxalaromcffn.supabase.co
# Anon key (public — usada pra validar JWT do client em AuthGuard)
SUPABASE_ANON_KEY=
# Service role key — bypassa RLS. Backend usa via SupabaseService.adminClient.
# NUNCA expor pro client. Em Railway, marca como "Secret".
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers ──
# Anthropic Claude — usado em ai.service, copilot, ai-test, ai-skills, etc.
ANTHROPIC_API_KEY=
# OpenAI — só pra embeddings (text-embedding-3-small) usados na knowledge
# base e match semântico de skills. Falha graceful se ausente (skills
# fazem fallback pra substring match).
OPENAI_API_KEY=

# ── Workers (Baileys/WhatsApp) ──
# URL do serviço workers (cross-process).
#   - Dev local: http://127.0.0.1:3030
#   - Railway: http://workers.railway.internal:3030
#     (substitua "workers" pelo nome do service na Railway — case-insensitive,
#     e use sempre PORTA HTTP, não PUBLIC_PORT). Private networking funciona
#     só com domínio .railway.internal e com bind 0.0.0.0 no service-alvo.
WORKER_INTERNAL_URL=http://127.0.0.1:3030

# Secret compartilhado entre api e workers pra autenticar chamadas internas
# (POST /internal/realtime). Gere com: openssl rand -hex 32
INTERNAL_API_KEY=

# ── Calendar integrations (Bloco Agendamentos 2) ──
# Chave AES-256 pra criptografar access_token/refresh_token OAuth no banco.
# OBRIGATÓRIO em produção. Gera com: openssl rand -base64 48
ENCRYPTION_KEY=

# Google Calendar OAuth — crie um projeto no console.cloud.google.com,
# habilite "Google Calendar API", crie credenciais OAuth 2.0 Web app
# e adicione $WEB_BASE_URL/configuracoes nos URIs autorizados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL absoluta do callback — precisa bater EXATO com a config no Google
GOOGLE_REDIRECT_URI=https://api.active.eclick.app.br/calendar/google/callback

# Calendly OAuth — registra em developer.calendly.com → My Apps
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=https://api.active.eclick.app.br/calendar/calendly/callback

# Base URL do web — usado pra redirecionar pós-OAuth de volta pra
# /configuracoes?calendar=success
WEB_BASE_URL=https://active.eclick.app.br

# ── Instagram Direct (Meta Graph API) ──
# Crie um App em developers.facebook.com → Tipo Business
# Adicione "Messenger" e "Instagram" nas permissões
# Em "Instagram Basic Display" e "Webhooks" configure:
#   Webhook URL: $API_URL/webhooks/instagram
#   Verify Token: mesmo valor de INSTAGRAM_WEBHOOK_VERIFY_TOKEN abaixo
#   Subscribed fields: messages, messaging_postbacks, message_reactions
META_APP_ID=
META_APP_SECRET=
# Base do domínio da API — usado pra derivar os callbacks de OAuth (Instagram,
# Meta Ads, Google Ads). Default https://api.active.eclick.app.br se ausente.
API_BASE_URL=https://api.active.eclick.app.br
# Callback do Instagram. Por padrão deriva de API_BASE_URL + /channels/instagram/callback.
# Só sete se precisar de um valor custom (precisa bater EXATO com a Valid OAuth
# Redirect URI no app Meta). NÃO confundir com META_OAUTH_REDIRECT_URI (esse é
# o override do callback de Meta ADS, path /ad-integrations/meta/callback).
# INSTAGRAM_OAUTH_REDIRECT_URI=https://api.active.eclick.app.br/channels/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=eclick-active-ig-verify

# ── TikTok for Developers ──
# Crie app em developers.tiktok.com → Login Kit. Adicione produtos:
# Login Kit + Comment Reply API + Webhook Subscriptions.
# Scopes: user.info.basic, user.info.profile, video.list, comment.list,
# comment.list.manage
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.active.eclick.app.br/channels/tiktok/callback
# Webhook em developers.tiktok.com → Webhooks tab. Configure URL:
# $API_URL/webhooks/tiktok com verify_token = TIKTOK_WEBHOOK_VERIFY_TOKEN
# Subscribed events: comment.create, comment.reply, follow
TIKTOK_WEBHOOK_VERIFY_TOKEN=eclick-active-tt-verify
# Webhook secret usado pra validar X-Tiktok-Signature (HMAC SHA-256)
TIKTOK_WEBHOOK_SECRET=

# ── Automation Bridge (Onda 4 / A3 — SaaS↔Active) ──
# Shared secret entre o motor StoreAutomationEngine do SaaS e o
# AutomationBridgeController do Active. O SaaS envia no header
# `X-Automation-Bridge-Token`, o Active valida no AutomationBridgeGuard.
# Gerar com: openssl rand -hex 32
# IMPORTANTE: o MESMO valor precisa ser configurado no SaaS Railway como
# `ACTIVE_AUTOMATION_BRIDGE_SECRET`. Sem essa env, o guard rejeita TUDO
# (fail-safe).
AUTOMATION_BRIDGE_SECRET=

# Kill-switch do worker que envia digests (medium 4h + daily low/opportunity).
# DISABLE_AUTOMATION_DIGEST_WORKER=true

