# ════════════════════════════════════════════════════════════
# e-Click Active — Web (Next.js .env.example)
# ════════════════════════════════════════════════════════════
# Apenas vars com prefixo NEXT_PUBLIC_ ficam disponíveis no client.
# Todas as outras (server-side only) podem ser adicionadas conforme
# o uso aumentar (ex: NEXTAUTH_SECRET no futuro).
# ════════════════════════════════════════════════════════════

# ── API ──
# URL do backend NestJS. Em dev: http://localhost:3001
# Em prod: https://api.active.eclick.app.br
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Supabase (client-side) ──
# Cliente browser usa o anon key pra autenticar via JWT (login,
# Realtime, RLS aplicada).
NEXT_PUBLIC_SUPABASE_URL=https://hzhrkfdwzxalaromcffn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
